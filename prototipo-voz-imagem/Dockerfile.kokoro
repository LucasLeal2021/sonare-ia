# PROTÓTIPO DESCARTÁVEL — Kokoro-82M (ONNX) + ffmpeg, vozes PT-BR
FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir kokoro-onnx soundfile
WORKDIR /modelo
RUN python -c "import urllib.request as u; b='https://github.com/thewh1teagle/kokoro-onnx/releases/download/model-files-v1.0/'; [u.urlretrieve(b+f, f) for f in ('kokoro-v1.0.onnx','voices-v1.0.bin')]" && ls -la /modelo
WORKDIR /work
